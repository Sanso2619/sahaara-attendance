# Sahaara Platform Environment Variables (Placeholder Template)

# Node Environment
NODE_ENV=development
PORT=4000

# Database Connection (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sahaara_db
DB_USER=sahaara_user
DB_PASSWORD=sahaara_secure_password
DATABASE_URL=postgres://sahaara_user:sahaara_secure_password@localhost:5432/sahaara_db

# JWT & Cookie Authentication Secrets
JWT_SECRET=replace_with_a_min_32_character_random_secret_key
COOKIE_SECRET=replace_with_another_32_character_random_secret

# Frontend App URL (for CORS & Cookie domain checks)
FRONTEND_URL=http://localhost:3000
